# Backend Settings
# Python/FastAPI environment variables
ENVIRONMENT=development
PORT=8000

# Gemini API Configuration
# Get this from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sign-In (Credentials > OAuth 2.0 Client IDs > Web application,
# in Google Cloud Console). Must match frontend/.env.local's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly, and the console's "Authorized
# JavaScript origins" must include the frontend's URL (e.g. http://localhost:3000).
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Pinecone Vector DB
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=policy-rules

# Relational Database
# SQLite (POC)
DATABASE_URL=sqlite:///./policy_engine.db
# PostgreSQL (Production example)
# DATABASE_URL=postgresql://user:password@localhost:5432/policy_engine

# Redis / Celery settings for asynchronous background processing
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Episodic memory (app/memory/) — separate Postgres DB for one-row-per-session
# history (Screening/Telephonic). `docker compose up postgres` brings up a
# local instance matching these defaults; the app degrades gracefully
# (episodic writes just skipped, logged) if this isn't reachable.
EPISODIC_DATABASE_URL=postgresql+psycopg2://policy:policy@localhost:5433/policy_episodic

# HuggingFace (Optional: For caching models like facebook/bart-large-mnli)
HF_HOME=./.cache/huggingface

# OCR binary path — leave unset on Linux (Render/Docker/HF Spaces resolve the
# apt-installed `tesseract` binary from PATH automatically). Only needed on
# Windows dev machines, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Comma-separated list of allowed frontend origins in production, e.g. your
# Vercel project's custom domain. Every *.vercel.app preview deployment is
# additionally allowed automatically (see VERCEL_ORIGIN_REGEX in app/main.py),
# so you don't need to list preview URLs here. Empty = allow any origin
# (fine for local dev only).
CORS_ORIGINS=

# Sarvam AI (Telephonic Agent — real outbound calling). app_id/app_version/
# connection_id/agent_phone_number come from the Sarvam console's outbound
# calling app + phone connection setup.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
# Leave blank to let the Sarvam app start at its own configured entry state.
SARVAM_INITIAL_STATE_NAME=
# This backend's own public HTTPS URL, which Sarvam calls back into with the
# outbound-call result — e.g. an ngrok tunnel in dev, or the deployed Render
# URL (https://your-backend.onrender.com) in production. Outbound calling is
# disabled with a clear error while this is unset.
PUBLIC_BASE_URL=

# SMTP (Screening Agent — candidate invite emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# This backend's frontend counterpart — used to build candidate-facing
# interview invite links (/screening-agent/session/{id}). Distinct from
# PUBLIC_BASE_URL above, which is this backend's own public URL.
FRONTEND_BASE_URL=http://localhost:3000

# --- MCP enterprise tool integrations (app/mcp/) ---
# Each block below is optional and independent — a connector reports itself
# as "not_configured" (GET /api/v1/mcp/connectors) rather than failing or
# faking a response while its block is unset. Fill in only the ones you
# actually want wired up.

# Slack — Bot User OAuth Token from an installed Slack App, scopes:
# chat:write, channels:read, channels:history.
SLACK_BOT_TOKEN=

# Microsoft Teams + SharePoint — one Azure AD app registration (Graph API,
# application permissions, admin-consented): ChannelMessage.Send,
# Channel.ReadBasic.All, Sites.Read.All (+ Sites.ReadWrite.All to upload).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Jira — Atlassian Cloud REST API v3. API token from
# id.atlassian.com/manage-profile/security/api-tokens.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# GitHub — a fine-grained personal access token scoped to the target repo(s)
# with Issues: Read & write, Pull requests: Read, Metadata: Read.
GITHUB_TOKEN=

# Salesforce — a Connected App with the OAuth username-password flow
# enabled. Rotate SALESFORCE_SECURITY_TOKEN whenever the password changes.
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# SAP — OAuth2 client-credentials against an SAP BTP-exposed OData service
# (S/4HANA Cloud, SuccessFactors, ...). Values come from the service
# instance's service key.
SAP_BASE_URL=
SAP_TOKEN_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=

# Google Workspace (Gmail, Drive, Calendar, Docs, Sheets) — two mutually
# exclusive auth modes; use whichever matches your account type.
#
# Mode 1: Google Workspace business/education accounts only (an admin must
# authorize the service account for domain-wide delegation in the Workspace
# admin console). Accepts the key JSON inline or a path to the key file.
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_DELEGATED_USER=
#
# Mode 2: personal @gmail.com accounts (or Workspace accounts without admin
# access) — OAuth2 user-consent flow. Run
# `cd backend && python scripts/google_oauth_device_setup.py` once (needs a
# "Desktop app" OAuth client ID from Google Cloud Console) to mint the
# refresh token. Preferred over Mode 1 when both are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# Distinct from GOOGLE_CLIENT_ID above, which is only for this app's own
# Google Sign-In.

# WhatsApp Agent — Meta WhatsApp Cloud API (app/services/whatsapp_service.py,
# api/whatsapp.py). ACCESS_TOKEN/PHONE_NUMBER_ID/BUSINESS_ACCOUNT_ID come from
# the Meta app dashboard (WhatsApp > API Setup). VERIFY_TOKEN is a string you
# invent yourself and register in the same Meta webhook config screen — Meta's
# GET /webhooks/whatsapp verification request must echo this exact value back.
# Same "empty = not configured, real error, never a fake response" convention
# as the MCP integrations above.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# App Secret (Meta App Dashboard > Settings > Basic) — verifies the
# X-Hub-Signature-256 header on every inbound webhook POST so a forged
# request to the public /webhooks/whatsapp URL is rejected. Required before
# exposing this endpoint publicly; skipped (with a logged warning) while unset.
WHATSAPP_APP_SECRET=

# --- Voice Identification Tool ---
PINECONE_VOICE_INDEX_NAME=voice-embeddings
VOICE_ID_SIMILARITY_THRESHOLD=0.70
VOICE_ID_MARGIN_THRESHOLD=0.15
VOICE_ID_MIN_SPEECH_DURATION=0.5
VOICE_ID_MIN_ENROLLMENT_SAMPLES=3
VOICE_ID_MAX_ENROLLMENT_SAMPLES=10
VOICE_ID_REPLAY_DETECTION_ENABLED=True
VOICE_ID_AI_VOICE_DETECTION_ENABLED=True
VOICE_ID_CHALLENGE_ENABLED=True

# Command Center — password unlock (server-side alternative to the voice
# gate; app/api/command_center.py). A bcrypt hash, never the plaintext.
# Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# Leave unset to disable password unlock (voice unlock keeps working either way).
COMMAND_CENTER_PASSWORD_HASH=

# Frontend Settings (Next.js)
# Bare origin only — every fetch call appends /api/v1/... itself, so a
# trailing /api/v1 here would double up into /api/v1/api/v1/... and break.
# In Vercel, set this to your deployed backend's URL, e.g.
# https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
